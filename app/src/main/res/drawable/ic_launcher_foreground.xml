<?xml version="1.0" encoding="utf-8"?>
<!--
    Icono foreground del launcher — un anillo con una chispa en el centro.
    Representa los "anillos de vida" del dashboard.
    Se usa en ic_launcher_foreground para el adaptive icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Anillo exterior — violet -->
    <path
        android:pathData="M54,10 A44,44 0 1,1 53.999,10 Z"
        android:strokeWidth="5"
        android:strokeColor="#9B6DFF"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round" />

    <!-- Anillo medio — cyan -->
    <path
        android:pathData="M54,20 A34,34 0 1,1 53.999,20 Z"
        android:strokeWidth="4"
        android:strokeColor="#22D3EE"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round" />

    <!-- Anillo interior — teal -->
    <path
        android:pathData="M54,30 A24,24 0 1,1 53.999,30 Z"
        android:strokeWidth="3.5"
        android:strokeColor="#2DD4BF"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round" />

    <!-- Centro: chispa/estrella -->
    <path
        android:pathData="M54,42 L56.5,50 L64,50 L58,55 L60,63 L54,58 L48,63 L50,55 L44,50 L51.5,50 Z"
        android:fillColor="#9B6DFF" />
</vector>
